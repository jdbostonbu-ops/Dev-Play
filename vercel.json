{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "game.js",
      "use": "@vercel/static"
    },
     { "src": "favicon.svg", 
     "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/style.css", "dest": "/style.css" },
    { "src": "/game.js", "dest": "/game.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
